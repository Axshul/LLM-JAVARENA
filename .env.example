# API Keys Configuration
# Copy this file to .env and add your actual keys

# Groq API Key (get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini API Keys (get from: https://makersuite.google.com/app/apikey)
# Add up to 14 keys for automatic load balancing and to avoid rate limits.
GEMINI_KEY_1=your_gemini_key_1_here
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
GEMINI_KEY_7=
GEMINI_KEY_8=
GEMINI_KEY_9=
GEMINI_KEY_10=
GEMINI_KEY_11=
GEMINI_KEY_12=
GEMINI_KEY_13=
GEMINI_KEY_14=

# n8n Webhook URL (optional - your personal n8n instance)
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
